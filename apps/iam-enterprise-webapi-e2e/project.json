{
  "name": "iam-enterprise-webapi-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["iam-enterprise-webapi"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/iam-enterprise-webapi-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": [
        "iam-enterprise-webapi:build",
        "iam-enterprise-webapi:serve"
      ]
    }
  }
}
