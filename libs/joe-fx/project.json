{
  "name": "joe-fx",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/joe-fx/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/joe-fx",
        "main": "libs/joe-fx/src/index.ts",
        "tsConfig": "libs/joe-fx/tsconfig.lib.json",
        "assets": ["libs/joe-fx/*.md"],
        "format": ["cjs"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/joe-fx/jest.config.cts"
      }
    }
  }
}
